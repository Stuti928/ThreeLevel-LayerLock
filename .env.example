# Environment variable template for Three-Level Password System
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:  copy .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env — it is listed in .gitignore
#
# The application reads these variables at startup.
# Unset variables fall back to the development defaults shown in settings.py.

# ── Django secret key ────────────────────────────────────────────────────────
# Generate a fresh key (run once):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# The key committed in the repository is INSECURE. Replace it before deploying.
SECRET_KEY=your-new-secret-key-here

# ── Debug mode ───────────────────────────────────────────────────────────────
# Set to False in production. Debug mode exposes full tracebacks to visitors.
DEBUG=False

# ── Allowed hosts ────────────────────────────────────────────────────────────
# Space-separated list of hostnames/IPs the application will serve.
# Example: ALLOWED_HOSTS=example.com www.example.com
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Production mode ──────────────────────────────────────────────────────────
# Set to 1 to enable HTTPS-only cookies and HSTS headers.
# Only set this when the application is deployed behind TLS.
DJANGO_PRODUCTION=0
